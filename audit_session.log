ENTRYPOINT ["sh" "-c" "exec java $JAVA_OPTS -jar /app/eco-air-backend.jar"]
USER sensor_user
EXPOSE [8080/tcp]
ENV OPERATOR_ID=898780
ENV JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0 -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -XX:SharedArchiveFile=/app/eco-air-backend.jsa -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp/eco-air-oom.hprof -Djava.security.egd=file:/dev/./urandom -Dspring.output.ansi.enabled=NEVER
RUN |1 STUDENT_ID=898780 /bin/sh -c chown -R sensor_user:sensorgroup /app # buildkit
RUN |1 STUDENT_ID=898780 /bin/sh -c set -eux;     java -XX:ArchiveClassesAtExit="${CDS_ARCHIVE}"          -XX:TieredStopAtLevel=1          -XX:+UseSerialGC          -Dspring.context.exit=onRefresh          -jar /app/eco-air-backend.jar;     test -s "${CDS_ARCHIVE}";     ls -lh /app # buildkit
ENV CDS_ARCHIVE=/app/eco-air-backend.jsa
COPY /build/target/eco-air-backend.jar /app/eco-air-backend.jar # buildkit
WORKDIR /app
RUN |1 STUDENT_ID=898780 /bin/sh -c addgroup -S -g 10001 sensorgroup  && adduser  -S -u 10001 -G sensorgroup -s /sbin/nologin -H sensor_user # buildkit
LABEL org.opencontainers.image.title=eco-air-backend org.opencontainers.image.version=1.0.0 org.opencontainers.image.description=Procesamiento de alertas ambientales criticas student.id=898780
ARG STUDENT_ID=898780
ENTRYPOINT ["/__cacert_entrypoint.sh"]
COPY --chmod=755 entrypoint.sh /__cacert_entrypoint.sh # buildkit
RUN /bin/sh -c set -eux;     echo "Verifying install ...";     echo "java --version"; java --version;     echo "Complete." # buildkit
RUN /bin/sh -c set -eux;     ARCH="$(apk --print-arch)";     case "${ARCH}" in        aarch64)          echo "Temurin ${JAVA_VERSION} binary for ${ARCH} is not available yet; retry after it is published upstream.";          exit 1;          ;;        x86_64)          ESUM='72423b1464907857f4e7ca854a2b8fd9f7cf6b9dd15bd3ea31ef6cf33b097aea';          BINARY_URL='https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.20.1%2B1/OpenJDK17U-jre_x64_alpine-linux_hotspot_17.0.20.1_1.tar.gz';          ;;        *)          echo "Unsupported arch: ${ARCH}";          exit 1;          ;;     esac;     wget -O /tmp/openjdk.tar.gz ${BINARY_URL};     wget -O /tmp/openjdk.tar.gz.sig ${BINARY_URL}.sig;     export GNUPGHOME="$(mktemp -d)";     gpg --batch --keyserver keyserver.ubuntu.com --recv-keys 3B04D753C9050D9A5D343F39843C48A565F8F04B;     gpg --batch --verify /tmp/openjdk.tar.gz.sig /tmp/openjdk.tar.gz;     rm -rf "${GNUPGHOME}" /tmp/openjdk.tar.gz.sig;     echo "${ESUM} */tmp/openjdk.tar.gz" | sha256sum -c -;     mkdir -p "$JAVA_HOME";     tar --extract         --file /tmp/openjdk.tar.gz         --directory "$JAVA_HOME"         --strip-components 1         --no-same-owner     ;     rm -f /tmp/openjdk.tar.gz; # buildkit
ENV JAVA_VERSION=jdk-17.0.20.1+1
RUN /bin/sh -c set -eux;     apk add --no-cache         fontconfig ttf-dejavu         gnupg         ca-certificates p11-kit-trust         musl-locales musl-locales-lang         tzdata         coreutils         openssl     ;     rm -rf /var/cache/apk/* # buildkit
ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8
